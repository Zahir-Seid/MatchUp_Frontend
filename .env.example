# ---------------------------------------------------------------------------
# MatchUp mobile build configuration
#
# Copy this file to .env and fill in the values. .env is gitignored.
# These values are compiled into the Android app and the PWA. They are public
# client configuration, not secrets. Never put a backend service-account key,
# merchant private key, or password here.
#
# Gradle also accepts every key below from local.properties or from the
# process environment. local.properties wins over .env.
# ---------------------------------------------------------------------------

# Android API base. Include the /v1 prefix.
# Emulator:  http://10.0.2.2:8082/v1
# Real phone: http://YOUR_COMPUTER_LAN_IP:8082/v1   (same Wi-Fi)
# Production: https://api.matchup.et/v1
API_BASE_URL_ANDROID=http://10.0.2.2:8082/v1

# Web API base. A path is resolved against the page origin, which is how the
# PWA talks to the API without CORS. You can also put an absolute URL here.
API_BASE_URL_WEB=/v1

# Google OAuth *web* client ID. The same ID is used for Android Credential
# Manager and for Google Identity Services in the PWA.
GOOGLE_WEB_CLIENT_ID=

# Reserved for standards-based Web Push. The Android client uses FCM instead;
# the PWA/iOS client uses Web Push + VAPID. Push is not enabled yet.
WEB_PUSH_VAPID_PUBLIC_KEY=

# Optional. When true, the Android build expects google-services.json and the
# Firebase messaging client. Leave false until the backend FCM work is merged.
ENABLE_FCM=false

# Informational version string shown in the profile screen.
APP_VERSION=1.0.0
